# Local paths and site
NEWS_ENV=development
NEWS_SITE_URL=http://127.0.0.1:8618
NEWS_TIMEZONE=
NEWS_DATABASE_PATH=var/data/news.db
NEWS_OUTPUT_PATH=var/site
NEWS_DATA_DIR=var/data

# Fetch stage; all optional
NEWS_HTTP_PROXY=
NEWS_FETCH_WINDOW_HOURS=24

# Translation; optional until phase 3
TRANSLATION_API_BASE_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_TIMEOUT_SECONDS=180
TRANSLATION_MAX_TOKENS=8192

# SMTP; optional until phase 5
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_RECIPIENTS=
SMTP_USE_TLS=true
