# Local paths and site
NEWS_ENV=development
NEWS_SITE_URL=http://127.0.0.1:8618
NEWS_TIMEZONE=Asia/Shanghai
NEWS_DATABASE_PATH=var/data/news.db
NEWS_OUTPUT_PATH=var/site
NEWS_DATA_DIR=var/data

# Fetch stage; all optional
NEWS_HTTP_PROXY=
NEWS_FETCH_WINDOW_HOURS=24

# Translation; the Admin-managed providers file is authoritative in production
TRANSLATION_API_BASE_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_API_TYPE=openai_chat
TRANSLATION_STREAM=true
TRANSLATION_TIMEOUT_SECONDS=180
TRANSLATION_MAX_TOKENS=8192

# Email delivery; disabled until SMTP, active subscriptions, and content are verified in Admin
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=implicit_tls
SMTP_FROM=
# Legacy one-time import only; manage active recipients in Admin subscriptions.
SMTP_RECIPIENTS=
EMAIL_MAINS_ENABLED=true
EMAIL_BRIEFS_ENABLED=true
EMAIL_MAIN_LIMIT=6
EMAIL_BRIEF_LIMIT=5
EMAIL_LANGUAGE=bi
EMAIL_SOURCE_FILTERS=
EMAIL_LAYOUT=digest
EMAIL_SUMMARY_LENGTH=standard
EMAIL_CATCHUP_WINDOW_HOURS=6

# Public subscription form; enable only after HTTPS and SMTP readiness checks pass
PUBLIC_SUBSCRIPTION_ENABLED=false
