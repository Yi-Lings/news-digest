# Resume queued translation actions without fetching a new edition.
[Unit]
Description=Resume queued news-digest translation automation
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=15min
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -E 75 -n /run/news-digest-worker.lock /usr/bin/docker compose -f /srv/news-digest/compose.yaml run --rm worker resume-automation --yes
TimeoutStartSec=45min
SuccessExitStatus=10
Restart=on-failure
RestartPreventExitStatus=10
RestartSec=15s
