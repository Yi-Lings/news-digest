# Fallback wake-up for durable Admin translation actions.
# PathChanged remains the fast path; this timer guarantees eventual pickup
# if the filesystem notification or one resume start is missed.
[Unit]
Description=Fallback wake for queued news-digest translation actions

[Timer]
OnCalendar=*-*-* *:*:00
OnCalendar=*-*-* *:*:30
AccuracySec=1s
Unit=news-digest-resume.service

[Install]
WantedBy=timers.target
